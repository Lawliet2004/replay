{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Replay",
  "version": "0.2.1",
  "identifier": "app.replay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Replay",
        "width": 1100,
        "height": 700,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; media-src 'none'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Local media player powered by libmpv",
    "longDescription": "Replay is a focused desktop media player for local files with a transparent control overlay and native libmpv playback.",
    "copyright": "Copyright (c) Replay Contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libmpv2 | libmpv1", "libx11-6"]
      },
      "rpm": {
        "depends": ["libmpv.so.2()(64bit)", "libX11.so.6()(64bit)"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
